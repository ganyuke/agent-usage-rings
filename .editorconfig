root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.js]
quote_type = single

[*.{json,xml,yml}]
indent_size = 2

[*.sh]
indent_style = tab
